# Copy to .env and fill in. Never commit .env.
hor.auth.db.password=
hor.auth.bootstrap.admin.email=
hor.auth.bootstrap.admin.password=
hor.aws.access-key-id=
hor.aws.secret-access-key=
hor.auth.allowed-origins=http://localhost:5180,http://localhost:5181,http://localhost:5182,http://localhost:5183
# JWT signing key file (relative to this folder). Copy the real one from the old machine;
# if missing, the service generates a new key and all existing tokens stop working.
hor.auth.signing-key-path=auth-signing-key.pem
