# auth-service settings. Copy to .env (in this folder; on the VM: /opt/hor-auth/.env) and fill in.
# Never commit .env. Format: KEY=value, no quotes, no spaces around "=".
# Only the REQUIRED lines must be set; every other line shows its default and can be left out.

# --- Database (REQUIRED: password) ---
HOR_DB_PASSWORD=
#HOR_DB_HOST=localhost
#HOR_DB_PORT=5432
#HOR_AUTH_DB_NAME=auth_db
#HOR_DB_USERNAME=auth_svc
#HOR_DB_POOL_SIZE=10

# --- First start: first platform admin (REQUIRED until the first admin exists) ---
HOR_AUTH_ADMIN_EMAIL=
HOR_AUTH_ADMIN_PASSWORD=
#HOR_AUTH_ADMIN_FULL_NAME=Platform Administrator

# --- Web origins allowed to send write requests (exact, or patterns: https://*.example.com = any subdomain, http://localhost:* = any port) ---
HOR_AUTH_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
#HOR_AUTH_COOKIE_DOMAIN=
#   production:
#   HOR_AUTH_ALLOWED_ORIGINS=https://*.handsoffretail.com
#   HOR_AUTH_COOKIE_DOMAIN=handsoffretail.com

# --- JWT signing key file (missing file = a NEW key is generated and all old tokens stop working) ---
# Local dev: auth-signing-key.pem (in this folder). VM: leave unset (default ~/.hor-stores/auth-signing-key.pem).
#HOR_AUTH_SIGNING_KEY_PATH=auth-signing-key.pem

# --- Tokens and login protection ---
#HOR_AUTH_ACCESS_TOKEN_TTL=PT15M
#HOR_AUTH_REFRESH_TOKEN_TTL=PT12H
#HOR_AUTH_MAX_FAILED_LOGINS=10
#HOR_AUTH_LOCK_DURATION=PT15M
#HOR_AUTH_BCRYPT_STRENGTH=12

# --- HTTP server (keep 127.0.0.1 in production; nginx is the public entry) ---
#HOR_SERVER_PORT=8091
#HOR_SERVER_ADDRESS=127.0.0.1

# --- Logging (TRACE, DEBUG, INFO, WARN, ERROR) ---
#HOR_LOG_LEVEL=INFO
#HOR_APP_LOG_LEVEL=INFO

# --- First start: default store (created only if missing) ---
#HOR_STORE_NAME=Tiki Hut
#HOR_STORE_CODE=8730_IN-47872
#HOR_STORE_POS_VENDOR=VERIFONE
#HOR_STORE_S3_FOLDER=Tiki_8730_IN-47872/Tiki_8730_IN-47872/
#HOR_STORE_ADDRESS_LINE1=8730 E US Highway 36
#HOR_STORE_CITY=Rockville
#HOR_STORE_STATE_CODE=IN
#HOR_STORE_POSTAL_CODE=47872
#HOR_STORE_COUNTRY_CODE=US
#HOR_STORE_TIMEZONE=America/Indiana/Indianapolis
